# ===========================================
# 공항 위험지수 시스템 - 프로덕션 환경변수
# ===========================================
# cp .env.production.example .env.production
# 아래 CHANGE_ME 값을 반드시 변경하세요!

# -------------------------------------------
# 기본 설정
# -------------------------------------------
ENV=production
DEBUG=false
# ⚠️ 반드시 변경! (openssl rand -hex 32)
SECRET_KEY=CHANGE_ME
TZ=Asia/Seoul

# -------------------------------------------
# 데이터베이스 (PostgreSQL)
# -------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=airport_risk
DB_USER=postgres
# ⚠️ 반드시 변경!
DB_PASSWORD=CHANGE_ME

# -------------------------------------------
# Redis
# -------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -------------------------------------------
# JWT 인증
# -------------------------------------------
# ⚠️ 반드시 변경! (openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------
# API 키 - 공공데이터
# -------------------------------------------
KMA_API_KEY=
DATA_GO_KR_API_KEY=

# -------------------------------------------
# 이메일 알림
# -------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_RECIPIENTS=

# -------------------------------------------
# CORS 허용 도메인 (실제 도메인으로 변경)
# -------------------------------------------
CORS_ORIGINS=http://localhost

# -------------------------------------------
# 프론트엔드 (Nginx 리버스 프록시)
# -------------------------------------------
VITE_API_URL=/api/v1
VITE_WS_URL=/ws

# -------------------------------------------
# Grafana
# -------------------------------------------
# ⚠️ 반드시 변경!
GF_ADMIN_PASSWORD=CHANGE_ME

# -------------------------------------------
# 로깅
# -------------------------------------------
LOG_LEVEL=WARNING
LOG_FORMAT=json

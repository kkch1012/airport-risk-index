# ===========================================
# 공항 위험지수 시스템 환경변수
# ===========================================
# 이 파일을 복사하여 .env로 저장 후 값을 설정하세요
# cp .env.example .env

# -------------------------------------------
# 기본 설정
# -------------------------------------------
ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-this-in-production

# -------------------------------------------
# 데이터베이스 (PostgreSQL)
# -------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=airport_risk
DB_USER=postgres
DB_PASSWORD=your-db-password

# 전체 연결 URL (위 설정 대신 사용 가능)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/airport_risk

# -------------------------------------------
# Redis
# -------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 전체 연결 URL
# REDIS_URL=redis://localhost:6379/0

# -------------------------------------------
# API 키 - 국내 데이터
# -------------------------------------------
# 기상청 API (https://data.kma.go.kr)
KMA_API_KEY=your-kma-api-key

# 공공데이터포털 (https://data.go.kr)
DATA_GO_KR_API_KEY=your-data-go-kr-api-key

# -------------------------------------------
# API 키 - 해외 데이터 (선택)
# -------------------------------------------
# WHO API (해당되는 경우)
WHO_API_KEY=

# Aviation Safety Network (크롤링 사용 시 불필요)
ASN_API_KEY=

# -------------------------------------------
# 이메일 알림 설정
# -------------------------------------------
# SMTP 서버 설정
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Airport Risk System <noreply@example.com>

# 알림 수신자 (쉼표로 구분)
ALERT_RECIPIENTS=admin@example.com,manager@example.com

# -------------------------------------------
# JWT 인증
# -------------------------------------------
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------
# Celery 설정
# -------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -------------------------------------------
# 프론트엔드
# -------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# -------------------------------------------
# 로깅
# -------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# -------------------------------------------
# 기타
# -------------------------------------------
# 타임존
TZ=Asia/Seoul

# CORS 허용 도메인 (쉼표로 구분)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
